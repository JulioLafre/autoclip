# YouTube Data API v3 habilitada no projeto Google Cloud.
YOUTUBE_API_KEY=
YOUTUBE_API_BASE_URL=https://www.googleapis.com/youtube/v3

# Provedor padrão: https://scrapecreators.com
SCRAPECREATORS_API_KEY=
SCRAPECREATORS_BASE_URL=https://api.scrapecreators.com
TIKTOK_PROVIDER=scrapecreators
INSTAGRAM_PROVIDER=scrapecreators

# Chaves por plataforma sobrescrevem a chave compartilhada.
TIKTOK_API_KEY=
INSTAGRAM_API_KEY=

# Outro provedor: veja o contrato HTTP no README.
# TIKTOK_PROVIDER=http
# TIKTOK_API_URL=https://seu-provedor.example/videos
# TIKTOK_API_KEY=sua-chave
# TIKTOK_API_KEY_HEADER=Authorization
# TIKTOK_API_KEY_PREFIX="Bearer "
# INSTAGRAM_PROVIDER=http
# INSTAGRAM_API_URL=https://seu-provedor.example/videos
# INSTAGRAM_API_KEY=sua-chave
# INSTAGRAM_API_KEY_HEADER=x-api-key
# INSTAGRAM_API_KEY_PREFIX=""

REQUEST_TIMEOUT_SECONDS=30
MAX_PAGES_PER_PROFILE=100
MAX_CONCURRENT_PROFILES=4

# Coleta automática (o JSON é relido a cada 5 segundos).
COLLECTION_ENABLED=true
# Caminhos relativos são resolvidos a partir da pasta de execução do backend.
# CREATORS_FILE=config/creators.json
# DOWNLOAD_DIR=media/entrada
# COLLECTION_STATE_DIR=media/coleta
COLLECTION_POLL_SECONDS=5
DOWNLOAD_TIMEOUT_SECONDS=300
# FFMPEG_DIR=C:/caminho/para/ffmpeg/bin
# DOWNLOAD_COOKIES_FILE=C:/caminho/para/cookies.txt

# Azure Speech para dublagem local. Use o código da região do recurso.
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=
